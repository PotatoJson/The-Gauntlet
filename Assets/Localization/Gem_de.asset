  m_TableData:
  - m_Id: 14632869888
    m_Localized: "St\xE4rke Edelstein"
    m_Metadata:
      m_Items: []
  - m_Id: 16352534528
    m_Localized: "Vitalit\xE4ts Edelstein"
    m_Metadata:
      m_Items: []
  - m_Id: 378757177344
    m_Localized: "Erh\xF6ht den Schaden"
    m_Metadata:
      m_Items: []
  - m_Id: 1386480656384
    m_Localized: "Erh\xF6ht die Lebenspunkte"
    m_Metadata:
      m_Items: []
  - m_Id: 17740849152
    m_Localized: Berserker Edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 19275964416
    m_Localized: "Bei 30% Leben oder weniger erh\xE4ltst du 1,4-fachen Schaden"
    m_Metadata:
      m_Items: []
  - m_Id: 101517877248
    m_Localized: Projektil Edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 115128393728
    m_Localized: "Das Projektil \xE4ndert sich basierend auf dem ausger\xFCsteten
      Fehdehandschuh"
    m_Metadata:
      m_Items: []
  - m_Id: 2466581045248
    m_Localized: "Windl\xE4ufer Edelstein"
    m_Metadata:
      m_Items: []
  - m_Id: 2468011302912
    m_Localized: "Reduziert die Ausdauerverz\xF6gerung vor der Erholung. Erh\xF6ht
      die Ausdauer-Erholungsrate"
    m_Metadata:
      m_Items: []
  - m_Id: 2848661168128
    m_Localized: Ausdauer edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 2849642635264
    m_Localized: "Erh\xF6ht die Ausdauer"
    m_Metadata:
      m_Items: []
  - m_Id: 3091771416576
    m_Localized: Scharfrichter
    m_Metadata:
      m_Items: []
  - m_Id: 3093449138176
    m_Localized: Jeder Kill stellt Ausdauer wieder her
    m_Metadata:
      m_Items: []
  - m_Id: 2300466519072768
    m_Localized: "Gew\xF6hnlich"
    m_Metadata:
      m_Items: []
  - m_Id: 2300467819307008
    m_Localized: Selten
    m_Metadata:
      m_Items: []
  - m_Id: 2300468859494400
    m_Localized: Ultra-selten
    m_Metadata:
      m_Items: []
  - m_Id: 46998600100601856
    m_Localized: Arcane Edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 46998600129961984
    m_Localized: "Erh\xF6ht das maximale Mana"
    m_Metadata:
      m_Items: []
  - m_Id: 46998602847870976
    m_Localized: Wellspring Edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 46998602847870977
    m_Localized: "Erh\xF6ht die Manaregeneration"
    m_Metadata:
      m_Items: []
  - m_Id: 46998604856942592
    m_Localized: Siphon Edelstein
    m_Metadata:
      m_Items: []
  - m_Id: 46998604856942593
    m_Localized: "Jeder Kill gibt Mana zur\xFCck"
    m_Metadata:
      m_Items: []
