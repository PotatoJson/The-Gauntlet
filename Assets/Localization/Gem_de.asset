    m_Metadata:
      m_Items: []
  - m_Id: 47366025136562176
    m_Localized: Schrein der Verbesserung
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836864
    m_Localized: "W\xE4hle einen Edelstein zum Verbessern. Der Schrein kann nur einmal
      benutzt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836865
    m_Localized: "Du hast keine ausger\xFCsteten Edelsteine, die verbessert werden
      k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836866
    m_Localized: Verbessern
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836867
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836868
    m_Localized: Der Edelstein leuchtet heller!
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836869
    m_Localized: "Dr\xFCcke {0}, um den Schrein zu benutzen"
    m_Metadata:
      m_Items: []
  - m_Id: 47366025228836870
    m_Localized: "Die Kraft des Schreins ist ersch\xF6pft."
    m_Metadata:
      m_Items: []
