    m_Localized: "\u708E\u304C\u6D88\u3048\u305F\u3068\u304D\u3001\u5BB6\u306F\u7A7A\u3063\u307D\u3060\u3063\u305F\u3002\u5BB6\u65CF\u306F\u3082\u3046\u3044\u306A\u304B\u3063\u305F\u3002"
